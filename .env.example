# Copy to .env and fill in. Never commit .env.

# Port and address the server listens on. Hosting platforms (Hostinger Web App) set PORT themselves.
# PORT=8080
# HOST=0.0.0.0

# Where messages, admin edits, uploads and admin users are kept. Must be OUTSIDE the app folder on
# Hostinger (each deploy replaces that folder), e.g. /home/u123456789/puzzlex-data. Docker: /data
# DATA_DIR=

# Public address of the site (share previews, sitemap). Default: https://www.puzzlexmedia.com
SITE_URL=https://www.puzzlexmedia.com

# Set to 1 when the site runs behind nginx/Caddy/Traefik/Cloudflare (reads the visitor's real IP, and
# sees HTTPS through X-Forwarded-Proto so the HSTS header is sent)
TRUST_PROXY=1

# IndexNow: tell Bing (ChatGPT search), Yandex & co. about changed pages a minute after each admin-panel save
# and after each deploy that changed the pages. Set only on the live site. The key is created in DATA_DIR.
# INDEXNOW=1

# Content-Security-Policy is sent as Report-Only (violations logged as "[csp] …"). Set to 1 to enforce it,
# once the logs show no violations on any page.
# CSP_ENFORCE=1

# Contact form email. Leave SMTP_HOST empty to only save messages to /data/messages.jsonl
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
# 1 for port 465 (SSL), 0 for 587 (STARTTLS)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# The sender address; most providers require it to be the SMTP account itself. Shown as "PuzzleX Media"
# unless you write the name yourself, e.g. SMTP_FROM="PuzzleX Media" <hello@puzzlexmedia.com>
SMTP_FROM=
# Everyone who sends the form gets a branded "we'll contact you within 48 hours" email (lib/emails.js),
# in Arabic or English. Set to 0 to turn it off.
# AUTOREPLY=0
# A request nobody has opened in the admin panel after this many hours sends the team one reminder
# (none on Fridays, the day off). Default 24; 0 turns reminders off.
# REMINDER_HOURS=24

# Admin panel cookie is Secure (HTTPS only). Set to 0 only to test the panel over plain HTTP on another machine.
# COOKIE_SECURE=0
